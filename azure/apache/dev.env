# Application settings
APP_NAME=pdex
ENVIRONMENT=dev
IMAGE_TAG=latest-dev
REPO_NAME=https://github.com/bcgov/pdex
REPO_BRANCH=dev

# Azure settings
ACR_NAME=acrpdexdev
AKS_CLUSTER=aks-pdex-dev
AKS_RG=rg-pdex-dev-central-ca

# Resource limits
CPU_REQUESTS=50m
CPU_LIMITS=250m
MEM_REQUESTS=128Mi
MEM_LIMITS=600Mi
MIN_REPLICAS=1
MAX_REPLICAS=2

# Secrets (to be stored in Azure Key Vault or Kubernetes Secret)
VAULT_ENV=secrets.env
NPM_ENV=dev